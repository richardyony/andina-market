{
  "datasets": [
    {
      "name": "ds_resumen",
      "displayName": "Resumen últimos 12 meses",
      "queryLines": [
        "WITH v AS (SELECT date_format(add_months(to_date(concat(max(year_month), '-01')), -11), 'yyyy-MM') AS desde FROM agg_sales_monthly), ",
        "ventas AS (SELECT sum(net_sales) AS net_sales_12m, sum(net_sales) / sum(orders) AS aov_12m FROM agg_sales_monthly, v WHERE year_month >= v.desde), ",
        "cobros AS (SELECT sum(approved) / (sum(approved) + sum(rejected)) AS approval_rate_12m, ",
        "  (SELECT sum(double_charges_pending) FROM agg_payments_monthly) AS double_charges_pending, ",
        "  (SELECT sum(double_charge_amount_pending) FROM agg_payments_monthly) AS double_charge_amount_pending ",
        "  FROM agg_payments_monthly, v WHERE year_month >= v.desde), ",
        "rc AS (SELECT date_format(add_months(to_date(concat(max(cohort_month), '-01')), -11), 'yyyy-MM') AS desde FROM agg_repurchase_cohorts WHERE is_complete), ",
        "recompra AS (SELECT sum(repurchased_90d) / sum(new_customers) AS repurchase_rate FROM agg_repurchase_cohorts, rc WHERE is_complete AND cohort_month >= rc.desde) ",
        "SELECT round(net_sales_12m, 0) AS net_sales_12m, round(aov_12m, 2) AS aov_12m, round(approval_rate_12m * 100, 1) AS approval_rate_12m, double_charges_pending, round(double_charge_amount_pending, 0) AS double_charge_amount_pending, round(repurchase_rate * 100, 1) AS repurchase_rate FROM ventas, cobros, recompra"
      ]
    },
    {
      "name": "ds_ventas_canal",
      "displayName": "Ventas netas mensuales por canal",
      "queryLines": [
        "SELECT to_date(concat(year_month, '-01')) AS mes, channel AS canal, sum(net_sales) AS ventas_netas ",
        "FROM agg_sales_monthly GROUP BY ALL"
      ]
    },
    {
      "name": "ds_ventas_pais",
      "displayName": "Ventas netas por país (12 meses)",
      "queryLines": [
        "WITH v AS (SELECT date_format(add_months(to_date(concat(max(year_month), '-01')), -11), 'yyyy-MM') AS desde FROM agg_sales_monthly) SELECT country AS pais, sum(net_sales) AS ventas_netas, round(sum(net_sales) / sum(orders), 2) AS ticket_promedio FROM agg_sales_monthly, v WHERE year_month >= v.desde GROUP BY country"
      ]
    },
    {
      "name": "ds_recompra",
      "displayName": "Recompra a 90 días por cohorte",
      "queryLines": [
        "SELECT to_date(concat(cohort_month, '-01')) AS cohorte, round(sum(repurchased_90d) / sum(new_customers) * 100, 1) AS tasa_recompra, sum(new_customers) AS clientes_nuevos FROM agg_repurchase_cohorts WHERE is_complete GROUP BY cohort_month HAVING sum(new_customers) >= 30"
      ]
    },
    {
      "name": "ds_aprobacion",
      "displayName": "Aprobación de pagos por método (12 meses)",
      "queryLines": [
        "WITH v AS (SELECT date_format(add_months(to_date(concat(max(year_month), '-01')), -11), 'yyyy-MM') AS desde FROM agg_payments_monthly) SELECT method AS metodo, round(sum(approved) / (sum(approved) + sum(rejected)) * 100, 1) AS tasa_aprobacion, sum(attempts) AS intentos FROM agg_payments_monthly, v WHERE year_month >= v.desde GROUP BY method"
      ]
    },
    {
      "name": "ds_devoluciones",
      "displayName": "Devoluciones por categoría (12 meses)",
      "queryLines": [
        "WITH v AS (SELECT date_format(add_months(to_date(concat(max(year_month), '-01')), -11), 'yyyy-MM') AS desde FROM agg_returns_monthly) SELECT category AS categoria, round(sum(returned_units) / sum(sold_units) * 100, 1) AS tasa_devolucion, sum(returned_amount) AS monto_devuelto FROM agg_returns_monthly, v WHERE year_month >= v.desde GROUP BY category"
      ]
    }
  ],
