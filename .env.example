# Copia este archivo como .env y completa tus valores. Nunca subas .env al repositorio.
SQL_SERVER=sql-andina.database.windows.net
SQL_DATABASE=andina_oltp
SQL_USER=sqladmin
SQL_PASSWORD=cambia-esta-clave
# Opcional: driver instalado (ver con `python -c "import pyodbc; print(pyodbc.drivers())"`)
SQL_DRIVER=ODBC Driver 18 for SQL Server
